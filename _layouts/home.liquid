---
layout: plain-text
---
{% assign home_content = site.data.home %}
{% assign home_phrases = home_content.phrases | default: empty %}
{% assign home_first_phrase = home_phrases.first | default: home_content.about %}
{% assign home_initial_phrase = home_first_phrase %}
{% if home_first_phrase.text %}
  {% assign home_initial_phrase = home_first_phrase.text %}
{% elsif home_first_phrase.parts %}
  {% assign home_initial_phrase = home_first_phrase.parts | map: 'text' | join: '' %}
{% elsif home_first_phrase.lines %}
  {% assign home_initial_phrase = home_first_phrase.lines | join: ' ' %}
{% endif %}

<main class="plain-home" role="main">
  <div class="wrap">
    <div class="terminal">
      <div class="titlebar">jiahaoh.io</div>
      <div class="screen">
        <h1 class="bio" id="plain-home-bio">
          <span
            class="bio-typer"
            data-plain-bio-typer
            data-about="{{ home_content.about | escape }}"
            data-about-color="{{ home_content.about_color | default: '' | escape }}"
            data-phrases="{{ home_phrases | jsonify | escape }}"
          >
            <span class="bio-typer-text">{{ home_initial_phrase | escape }}</span><span class="bio-typer-caret" aria-hidden="true"></span>
          </span>
        </h1>

        <section class="plain-home-dashboard" id="plain-home-dashboard" aria-label="Current status" hidden>
          <div class="plain-home-dashboard-row">
            <span class="key">now</span>
            <span class="value">Spatial biology, imaging as measurement, and AI-assisted analysis tooling.</span>
          </div>
          <div class="plain-home-dashboard-row">
            <span class="key">question</span>
            <span class="value">How should image-derived signals enter biological reasoning?</span>
          </div>
          <div class="plain-home-dashboard-row">
            <span class="key">next</span>
            <span class="value">Turn rough working notes into a clearer public trail.</span>
          </div>
        </section>

        <section
          class="plain-visit-panel"
          id="plain-visit-panel"
          aria-label="Visit map"
          data-visit-endpoint="{{ site.plain_visits_endpoint | default: '' | escape }}"
          hidden
        >
          <div class="plain-visit-head">
            <span class="plain-visit-command">/visits</span>
            <span class="plain-visit-mode" id="plain-visit-mode">demo</span>
          </div>
          <div class="plain-visit-stats" aria-live="polite">
            <div class="plain-visit-stat">
              <span class="key">total views</span>
              <span class="value" id="plain-visit-total">--</span>
            </div>
            <div class="plain-visit-stat">
              <span class="key">today</span>
              <span class="value" id="plain-visit-today">--</span>
            </div>
            <div class="plain-visit-stat">
              <span class="key">regions</span>
              <span class="value" id="plain-visit-region-count">--</span>
            </div>
            <div class="plain-visit-stat">
              <span class="key">updated</span>
              <span class="value" id="plain-visit-updated">--</span>
            </div>
          </div>
          <div class="plain-visit-visual">
            <div
              class="plain-visit-map"
              id="plain-visit-map"
              data-map-src="{{ '/assets/maps/worldLow-pixels.svg' | relative_url }}"
              role="img"
              aria-label="Pixel world map of approximate visitor regions"
            ></div>
            <aside class="plain-visit-ranking" aria-label="Top visitor countries">
              <div class="plain-visit-ranking-title">countries</div>
              <ol class="plain-visit-regions" id="plain-visit-regions"></ol>
            </aside>
          </div>
          <div class="plain-visit-note" id="plain-visit-note">approx. region only &middot; no IPs stored</div>
        </section>

        <div class="promptline">
          <span class="sigil">$</span>
          <input
            id="plain-prompt"
            aria-label="command"
            placeholder="type a command..."
            spellcheck="false"
            autocomplete="off"
          >
        </div>

        <div class="suggest" id="plain-suggest"></div>
        <div class="history" id="plain-history" hidden></div>
      </div>
    </div>
  </div>
</main>
