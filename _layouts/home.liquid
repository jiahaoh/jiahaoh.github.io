---
layout: plain-text
---

<main class="plain-home" role="main">
  <div class="wrap">
    <div class="terminal">
      <div class="titlebar">jiahaoh.io</div>
      <div class="screen">
        <p class="bio">
          A small, slow garden of <em>working notes</em> on AI for science — by Jiahao, Ph.D. candidate at MIT.
        </p>

        <div class="promptline">
          <span class="sigil">$</span>
          <input
            id="plain-prompt"
            aria-label="command"
            placeholder="type a command...  (blog, help)"
            spellcheck="false"
            autocomplete="off"
          >
        </div>

        <div class="suggest" id="plain-suggest"></div>
        <div class="history" id="plain-history" hidden></div>
      </div>
    </div>
  </div>
</main>
