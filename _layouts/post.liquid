---
layout: plain-text
---
{% assign year = page.date | date: '%Y' %}
{% assign words = content | strip_html | number_of_words %}
{% assign read_time = words | divided_by: 200 | plus: 1 %}
{% assign slug = page.slug | default: page.title | slugify %}
{% assign updated = page.last_updated | default: page.last_modified_at | default: page.last_modified %}

{% if page._styles %}
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<div class="plain-progress" id="plain-progress"></div>

<aside class="plain-toc-pin" aria-label="Post metadata and table of contents">
  <div class="plain-meta-rows">
    <div class="plain-meta-row">
      <span class="k">date</span>
      <span class="v">
        {{ page.date | date: '%Y-%m-%d' }}
        {% if updated %}
          <br><span class="edit">edit {{ updated | date: '%m-%d' }}</span>
        {% endif %}
      </span>
    </div>

    {% if page.tags or page.categories or page.status or page.meta %}
      <div class="plain-meta-row">
        <span class="k">tags</span>
        <span class="v">
          {% for tag in page.tags %}
            <span class="plain-meta-tag">{{ tag }}</span>
          {% endfor %}
          {% for category in page.categories %}
            <span class="plain-meta-tag">{{ category }}</span>
          {% endfor %}
          {% if page.status %}
            <span class="plain-status">{{ page.status }}</span>
          {% elsif page.meta %}
            <span class="plain-status">{{ page.meta }}</span>
          {% endif %}
        </span>
      </div>
    {% endif %}

    <div class="plain-meta-row">
      <span class="k">read</span>
      <span class="v">{{ read_time }} min · {{ words }} words</span>
    </div>
  </div>
  <div class="plain-div"></div>
  <div class="lbl">contents</div>
  <ol id="plain-toc"></ol>
</aside>

<main class="plain-post-wrap" role="main">
  <nav class="plain-crumbs" aria-label="Breadcrumb">
    <span class="sigil">$</span>cat
    <span class="sep">·</span>
    <a href="{{ '/' | relative_url }}">~</a><span class="sep">/</span><a href="{{ '/blog/' | relative_url }}">blog</a><span class="sep">/</span><a href="{{ year | prepend: '/blog/' | relative_url }}">{{ year }}</a><span class="sep">/</span><span class="here">{{ slug }}</span>
  </nav>

  <header>
    <h1 class="plain-post-title">{{ page.title }}</h1>
    <div class="plain-inline-meta">
      <div>{{ page.date | date: '%Y-%m-%d' }} · {{ read_time }} min · {{ words }} words</div>
      {% if page.tags or page.categories %}
        <div>
          {% for tag in page.tags %}
            <span class="tag">{{ tag }}</span>
          {% endfor %}
          {% for category in page.categories %}
            <span class="tag">{{ category }}</span>
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </header>

  <article class="plain-post-body" id="markdown-content">
    {{ content }}
  </article>

  <nav class="plain-post-foot" aria-label="Post navigation">
    {% if page.previous %}
      <a href="{{ page.previous.url | relative_url }}">&larr; prev</a>
    {% else %}
      <span></span>
    {% endif %}
    <a href="{{ '/blog/' | relative_url }}">$ cd ..</a>
    {% if page.next %}
      <a href="{{ page.next.url | relative_url }}">next &rarr;</a>
    {% else %}
      <span></span>
    {% endif %}
  </nav>

  <div class="plain-post-extra">
    {% if page.citation %}
      {% include citation.liquid %}
    {% endif %}

    {% if page.related_publications %}
      <h2>References</h2>
      <div class="publications">
        {% bibliography --group_by none --cited_in_order %}
      </div>
    {% endif %}

    {% if site.related_blog_posts and site.related_blog_posts.enabled %}
      {% if page.related_posts == null or page.related_posts %}
        {% include related_posts.liquid %}
      {% endif %}
    {% endif %}

    {% if site.disqus_shortname and page.disqus_comments %}
      {% include disqus.liquid %}
    {% endif %}
    {% if site.giscus and page.giscus_comments %}
      {% include giscus.liquid %}
    {% endif %}
  </div>
</main>
