<script>
  document.addEventListener('DOMContentLoaded', () => {
    const input = document.getElementById('plain-prompt');
    const suggest = document.getElementById('plain-suggest');
    const history = document.getElementById('plain-history');
    const dashboard = document.getElementById('plain-home-dashboard');
    const visitPanel = document.getElementById('plain-visit-panel');
    const feedbackPanel = document.getElementById('plain-feedback-panel');
    const bio = document.getElementById('plain-home-bio');
    const bioController = initPlainBioTyper();
    const visitController = initPlainVisits();
    const feedbackController = initPlainFeedback();
    initPlainCommandPalette();

    if (input && suggest && history) {
      const commands = [
        { cmd: 'blog', desc: 'Notes, essays, and working drafts.', href: "{{ '/blog/' | relative_url }}" },
        { cmd: 'about', desc: 'Type a short introduction here.', href: null, action: 'about' },
        { cmd: 'help', desc: 'Show all available commands.', href: null },
      ];
      const helpCommands = ['blog', 'about', 'status', 'visits', 'feedback'];
      const aliases = { map: 'visits', traffic: 'visits', where: 'visits', writing: 'blog' };

      function renderPrompt() {
        const query = input.value.trim().toLowerCase().replace(/^\//, '');
        const matches = query ? commands.filter((command) => command.cmd.startsWith(query)) : commands;
        suggest.innerHTML = matches
          .map(
            (command, index) => `
              <a class="sg-row${index === 0 ? ' active' : ''}" data-cmd="${command.cmd}" href="${command.href || '#'}">
                <span class="arr">→</span>
                <span class="cmd">/${command.cmd}</span>
                <span class="desc">${command.desc}</span>
              </a>
            `
          )
          .join('');
      }

      function writeHistory(command, message, options = {}) {
        history.hidden = false;
        const key = options.key ? ` data-history-key="${options.key}"` : '';
        const entry = `<div class="history-entry"${key}><div class="echo"><span class="sig">$ </span>${command}</div><div>${message}</div></div>`;

        if (options.key) {
          const existing = history.querySelector(`[data-history-key="${options.key}"]`);
          if (existing) {
            existing.outerHTML = entry;
            return;
          }
        }

        history.insertAdjacentHTML('beforeend', entry);
      }

      function resetHome() {
        if (dashboard) dashboard.hidden = true;
        if (visitPanel) visitPanel.hidden = true;
        if (feedbackPanel) feedbackPanel.hidden = true;
        if (bio) bio.hidden = false;
        input.value = '';
        history.hidden = true;
        history.innerHTML = '';
        renderPrompt();
      }

      function run(command) {
        const raw = (command || '').trim().toLowerCase().replace(/^\//, '');
        const normalized = aliases[raw] || raw;
        if (!normalized) return;
        const hit = commands.find((item) => item.cmd === normalized);

        if (normalized === 'status') {
          if (bio) bio.hidden = true;
          if (visitPanel) visitPanel.hidden = true;
          if (feedbackPanel) feedbackPanel.hidden = true;
          if (dashboard) dashboard.hidden = false;
          input.value = '';
          renderPrompt();
          return;
        }

        if (hit && hit.href) {
          window.location.href = hit.href;
          return;
        }

        if (hit && hit.action === 'about') {
          if (dashboard) dashboard.hidden = true;
          if (visitPanel) visitPanel.hidden = true;
          if (feedbackPanel) feedbackPanel.hidden = true;
          if (bio) bio.hidden = false;
          if (bioController) bioController.typeAbout();
          input.value = '';
          renderPrompt();
          return;
        }

        if (normalized === 'visits') {
          if (dashboard) dashboard.hidden = true;
          if (feedbackPanel) feedbackPanel.hidden = true;
          if (bio) bio.hidden = true;
          if (visitPanel) visitPanel.hidden = false;
          if (visitController) visitController.show();
          input.value = '';
          renderPrompt();
          return;
        }

        if (normalized === 'feedback') {
          if (dashboard) dashboard.hidden = true;
          if (visitPanel) visitPanel.hidden = true;
          if (bio) bio.hidden = true;
          if (feedbackPanel) feedbackPanel.hidden = false;
          if (feedbackController) feedbackController.show();
          input.value = '';
          renderPrompt();
          return;
        }

        if (normalized === 'help' || normalized === '?') {
          writeHistory(normalized, `available: ${helpCommands.join(' · ')}`, { key: 'help' });
        } else {
          writeHistory(normalized, `command not found: <b>${normalized}</b> · try <span class="accent">help</span>`, { key: 'unknown-command' });
        }

        input.value = '';
        renderPrompt();
      }

      input.addEventListener('input', renderPrompt);
      input.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
          event.preventDefault();
          resetHome();
          return;
        }

        if (event.key === 'Enter') {
          event.preventDefault();
          run(input.value);
        }
        if (event.key === 'Tab') {
          event.preventDefault();
          const query = input.value.trim().toLowerCase().replace(/^\//, '');
          const match = (query ? commands.filter((command) => command.cmd.startsWith(query)) : commands)[0];
          if (match) {
            input.value = match.cmd;
            renderPrompt();
          }
        }
      });
      suggest.addEventListener('click', (event) => {
        const row = event.target.closest('.sg-row');
        if (!row) return;
        const hit = commands.find((item) => item.cmd === row.dataset.cmd);
        if (hit && hit.href) return;
        event.preventDefault();
        run(row.dataset.cmd);
      });

      input.focus();
      renderPrompt();
    }

    function initPlainBioTyper() {
      const typer = document.querySelector('[data-plain-bio-typer]');
      if (!typer) return null;

      const text = typer.querySelector('.bio-typer-text');
      let phrases = [];

      try {
        phrases = JSON.parse(typer.dataset.phrases || '[]')
          .map(normalizePhrase)
          .filter((phrase) => phrase.content);
      } catch (error) {
        phrases = [];
      }

      if (!text || phrases.length === 0) return null;

      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      renderPhrase(phrases[0]);
      if (reducedMotion) {
        return {
          typeAbout() {
            renderPhrase(normalizePhrase({ text: typer.dataset.about || phrases[0].content, color: typer.dataset.aboutColor }));
          },
        };
      }

      let index = 0;
      let charIndex = phrases[index].content.length;
      let deleting = false;
      let timer = null;
      const hiddenDelay = 800;
      const holdDelay = 2600;
      const nextPhraseDelay = 420;
      const deleteDelay = 42;
      const typeDelay = 78;

      const schedule = (callback, delay) => {
        window.clearTimeout(timer);
        timer = window.setTimeout(callback, delay);
      };

      const tickCycle = () => {
        if (document.hidden) {
          schedule(tickCycle, hiddenDelay);
          return;
        }

        const phrase = phrases[index];
        renderPhrase(phrase, charIndex);

        if (!deleting && charIndex === phrase.content.length) {
          deleting = true;
          schedule(tickCycle, holdDelay);
          return;
        }

        if (deleting && charIndex === 0) {
          deleting = false;
          index = (index + 1) % phrases.length;
          schedule(tickCycle, nextPhraseDelay);
          return;
        }

        charIndex += deleting ? -1 : 1;
        schedule(tickCycle, deleting ? deleteDelay : typeDelay);
      };

      const typePhrase = (phrase) => {
        const normalizedPhrase = normalizePhrase(phrase);
        if (!normalizedPhrase.content) return;

        window.clearTimeout(timer);
        renderPhrase(normalizedPhrase, 0);
        let nextIndex = 0;

        const tickCustom = () => {
          if (document.hidden) {
            schedule(tickCustom, hiddenDelay);
            return;
          }

          nextIndex += 1;
          renderPhrase(normalizedPhrase, nextIndex);

          if (nextIndex < normalizedPhrase.content.length) {
            schedule(tickCustom, typeDelay);
          }
        };

        tickCustom();
      };

      schedule(tickCycle, holdDelay);

      return {
        typeAbout() {
          typePhrase({ text: typer.dataset.about || phrases[0].content, color: typer.dataset.aboutColor });
        },
      };

      function normalizePhrase(phrase) {
        if (typeof phrase === 'string') {
          return { type: 'text', content: phrase, color: '' };
        }

        if (!phrase || typeof phrase !== 'object') {
          return { type: 'text', content: '', color: '' };
        }

        if (phrase.type === 'code') {
          const lines = Array.isArray(phrase.lines) ? phrase.lines : [];
          return {
            type: 'code',
            language: (phrase.language || 'text').toString().toLowerCase(),
            content: (lines.length ? lines.join('\n') : phrase.code || phrase.text || '').toString(),
            color: phrase.color || '',
          };
        }

        const parts = normalizeTextParts(phrase.parts);
        if (parts.length) {
          return {
            type: 'text',
            content: parts.map((part) => part.text).join(''),
            color: phrase.color || '',
            parts,
          };
        }

        return { type: 'text', content: (phrase.text || phrase.phrase || '').toString(), color: phrase.color || '', parts: [] };
      }

      function renderPhrase(phrase, length) {
        const visibleLength = typeof length === 'number' ? length : phrase.content.length;
        const content = phrase.content.slice(0, visibleLength);
        const isCode = phrase.type === 'code';

        applyPhraseColor(phrase.color);
        typer.classList.toggle('is-code', isCode);

        if (!isCode) {
          if (phrase.parts && phrase.parts.length) {
            text.innerHTML = renderTextParts(phrase.parts, visibleLength);
            return;
          }

          text.textContent = content;
          return;
        }

        text.innerHTML = renderCode(content, phrase.language);
      }

      function normalizeTextParts(parts) {
        if (!Array.isArray(parts)) return [];

        return parts
          .map((part) => {
            if (typeof part === 'string') return { text: part, color: '' };
            if (!part || typeof part !== 'object') return { text: '', color: '' };
            return { text: (part.text || '').toString(), color: part.color || '' };
          })
          .filter((part) => part.text);
      }

      function renderTextParts(parts, visibleLength) {
        let remaining = visibleLength;

        return parts
          .map((part) => {
            if (remaining <= 0) return '';

            const visibleText = part.text.slice(0, remaining);
            remaining -= visibleText.length;

            if (!visibleText) return '';

            const resolvedColor = resolvePhraseColor(part.color);
            if (!resolvedColor) return escapeHtml(visibleText);

            return `<span class="bio-inline-color" style="--bio-inline-color: ${resolvedColor}">${escapeHtml(visibleText)}</span>`;
          })
          .join('');
      }

      function renderCode(content, language) {
        const lang = cleanLanguage(language);
        const lines = content.split('\n');
        const renderedLines = lines.map((line) => highlightLine(line, lang) || '&#8203;').join('<br>');

        return `<span class="bio-code">${renderedLines}</span>`;
      }

      function highlightLine(line, language) {
        const patterns = {
          python:
            /(#.*)|("(?:\\.|[^"\\])*"|'(?:\\.|[^'\\])*')|\b(def|return|for|in|while|if|else|elif|import|from|as|class|with|lambda|None|True|False|and|or|not)\b|\b(\d+(?:\.\d+)?)\b|\b([A-Za-z_]\w*)(?=\s*\()|\b([A-Za-z_]\w*)\b/g,
          shell: /(#.*)|("(?:\\.|[^"\\])*"|'(?:\\.|[^'\\])*')|\b(cd|find|open|python|bundle|git|jekyll|npm|npx|echo|cat|rg)\b|(^|\s)(--?[\w-]+)/g,
        };
        const pattern = patterns[language];

        if (!pattern) return escapeHtml(line);

        let html = '';
        let lastIndex = 0;

        Array.from(line.matchAll(pattern)).forEach((match) => {
          html += escapeHtml(line.slice(lastIndex, match.index));
          if (match[1]) html += token('comment', match[0]);
          else if (match[2]) html += token('string', match[0]);
          else if (match[3]) html += token('keyword', match[0]);
          else if (language === 'shell' && match[5]) html += escapeHtml(match[4]) + token('keyword', match[5]);
          else if (match[4]) html += token('number', match[0]);
          else if (language === 'python' && match[5]) html += token('function', match[0]);
          else if (language === 'python' && match[6]) html += token('variable', match[0]);
          lastIndex = match.index + match[0].length;
        });

        return html + escapeHtml(line.slice(lastIndex));
      }

      function token(kind, value) {
        return `<span class="tok tok-${kind}">${escapeHtml(value)}</span>`;
      }

      function escapeHtml(value) {
        return value.toString().replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
      }

      function cleanLanguage(language) {
        return (
          (language || 'text')
            .toString()
            .toLowerCase()
            .replace(/[^a-z0-9_-]/g, '') || 'text'
        );
      }

      function applyPhraseColor(color) {
        const resolvedColor = resolvePhraseColor(color);

        if (resolvedColor) {
          typer.style.setProperty('--bio-phrase-color', resolvedColor);
        } else {
          typer.style.removeProperty('--bio-phrase-color');
        }
      }

      function resolvePhraseColor(color) {
        const namedColors = {
          ink: 'var(--plain-ink)',
          soft: 'var(--plain-ink-soft)',
          muted: 'var(--plain-ink-mute)',
          faint: 'var(--plain-ink-faint)',
          accent: 'var(--plain-accent)',
          keyword: 'var(--plain-code-kw)',
          string: 'var(--plain-code-string)',
          number: 'var(--plain-code-number)',
          function: 'var(--plain-code-function)',
          variable: 'var(--plain-code-variable)',
          comment: 'var(--plain-code-comment)',
        };
        const value = (color || '').toString().trim().toLowerCase();

        if (namedColors[value]) return namedColors[value];
        if (/^#(?:[0-9a-f]{3}|[0-9a-f]{6})$/i.test(value)) return value;
        return '';
      }
    }

    function initPlainFeedback() {
      const panel = document.getElementById('plain-feedback-panel');
      if (!panel) return null;

      const thread = document.getElementById('plain-feedback-thread');
      const fallback = document.getElementById('plain-feedback-fallback');
      let loaded = false;

      return {
        show() {
          if (loaded || !thread) return;

          const attrs = {
            src: 'https://giscus.app/client.js',
            'data-repo': panel.dataset.giscusRepo,
            'data-repo-id': panel.dataset.giscusRepoId,
            'data-category': panel.dataset.giscusCategory,
            'data-category-id': panel.dataset.giscusCategoryId,
            'data-mapping': panel.dataset.giscusMapping || 'specific',
            'data-term': panel.dataset.giscusTerm || '/feedback',
            'data-strict': panel.dataset.giscusStrict || '1',
            'data-reactions-enabled': panel.dataset.giscusReactionsEnabled || '1',
            'data-emit-metadata': panel.dataset.giscusEmitMetadata || '0',
            'data-input-position': panel.dataset.giscusInputPosition || 'bottom',
            'data-theme': panel.dataset.giscusTheme || 'preferred_color_scheme',
            'data-lang': panel.dataset.giscusLang || 'en',
            crossorigin: 'anonymous',
            async: '',
          };

          const hasRequiredConfig = attrs['data-repo'] && attrs['data-repo-id'] && attrs['data-category'] && attrs['data-category-id'];

          if (!hasRequiredConfig) {
            if (fallback) fallback.hidden = false;
            return;
          }

          const script = document.createElement('script');
          Object.entries(attrs).forEach(([key, value]) => {
            if (value !== undefined && value !== null) script.setAttribute(key, value);
          });
          thread.appendChild(script);
          loaded = true;
        },
      };
    }

    function initPlainVisits() {
      const panel = document.getElementById('plain-visit-panel');
      if (!panel) return null;

      const endpoint = cleanEndpoint(panel.dataset.visitEndpoint);
      const map = document.getElementById('plain-visit-map');
      const fields = {
        mode: document.getElementById('plain-visit-mode'),
        total: document.getElementById('plain-visit-total'),
        today: document.getElementById('plain-visit-today'),
        regions: document.getElementById('plain-visit-region-count'),
        updated: document.getElementById('plain-visit-updated'),
        list: document.getElementById('plain-visit-regions'),
        note: document.getElementById('plain-visit-note'),
      };
      const numberFormatter = new Intl.NumberFormat('en-US');
      const regionNameFormatter = makeRegionNameFormatter();
      let activeRequest = null;
      let mapLoad = null;

      const mockStats = {
        mode: 'demo',
        total: 1284,
        today: 27,
        lastUpdated: new Date(Date.now() - 7 * 60 * 1000).toISOString(),
        countries: [
          { code: 'US', count: 612 },
          { code: 'CN', count: 184 },
          { code: 'GB', count: 103 },
          { code: 'DE', count: 88 },
          { code: 'JP', count: 67 },
          { code: 'SG', count: 42 },
          { code: 'AU', count: 31 },
          { code: 'BR', count: 24 },
        ],
      };

      recordVisit();
      renderMap([]);

      return {
        show() {
          renderLoading();
          const request = loadStats();
          activeRequest = request;

          request
            .then((stats) => {
              if (activeRequest === request) renderStats(stats);
            })
            .catch(() => {
              if (activeRequest === request) renderStats(normalizeStats(mockStats, 'demo'));
            });
        },
      };

      function recordVisit() {
        if (!endpoint) return;

        const storageKey = `plain-visit-recorded:${window.location.pathname}`;
        try {
          if (window.sessionStorage.getItem(storageKey)) return;
          window.sessionStorage.setItem(storageKey, '1');
        } catch (error) {
          // Session storage is only a courtesy guard; the Worker remains the source of truth.
        }

        const body = JSON.stringify({ path: window.location.pathname });
        const blob = new Blob([body], { type: 'text/plain' });

        if (navigator.sendBeacon && navigator.sendBeacon(endpoint, blob)) return;

        window
          .fetch(endpoint, {
            method: 'POST',
            body,
            headers: { 'content-type': 'text/plain' },
            keepalive: true,
            credentials: 'omit',
          })
          .catch(() => {});
      }

      async function loadStats() {
        if (!endpoint) return normalizeStats(mockStats, 'demo');

        try {
          const response = await window.fetch(endpoint, {
            headers: { accept: 'application/json' },
            cache: 'no-store',
            credentials: 'omit',
          });

          if (!response.ok) throw new Error(`Visit summary failed: ${response.status}`);

          return normalizeStats(await response.json(), 'live');
        } catch (error) {
          const fallback = normalizeStats(mockStats, 'demo');
          fallback.note = 'demo fallback / live endpoint unavailable';
          return fallback;
        }
      }

      function renderLoading() {
        setText(fields.mode, endpoint ? 'live' : 'demo');
        setText(fields.total, '...');
        setText(fields.today, '...');
        setText(fields.regions, '...');
        setText(fields.updated, '...');
        renderRegionList([]);
        renderMap([]);
        setText(fields.note, endpoint ? 'loading live summary...' : 'demo data / add plain_visits_endpoint for live counts');
      }

      function renderStats(stats) {
        const countries = stats.countries || [];
        setText(fields.mode, stats.mode === 'live' ? 'live' : 'demo');
        setText(fields.total, numberFormatter.format(stats.total || 0));
        setText(fields.today, numberFormatter.format(stats.today || 0));
        setText(fields.regions, numberFormatter.format(stats.regions || countries.length));
        setText(fields.updated, relativeTime(stats.lastUpdated));
        renderRegionList(countries);
        renderMap(countries);
        setText(
          fields.note,
          stats.note || (stats.mode === 'live' ? 'approx. region only / no IPs stored' : 'demo data / add plain_visits_endpoint for live counts')
        );
      }

      function renderRegionList(countries) {
        if (!fields.list) return;

        const topCountries = countries
          .filter((country) => country.count > 0)
          .sort((a, b) => b.count - a.count)
          .slice(0, 6);
        const maxCount = Math.max(1, ...topCountries.map((country) => country.count));

        fields.list.innerHTML = '';

        if (!topCountries.length) {
          const emptyItem = document.createElement('li');
          emptyItem.className = 'plain-visit-region-empty';
          emptyItem.textContent = 'waiting for first visitors';
          fields.list.append(emptyItem);
          return;
        }

        topCountries.forEach((country, index) => {
          const item = document.createElement('li');
          const rank = document.createElement('span');
          const name = document.createElement('b');
          const count = document.createElement('span');
          const bar = document.createElement('span');
          rank.className = 'rank';
          name.className = 'name';
          count.className = 'count';
          bar.className = 'bar';
          rank.textContent = String(index + 1).padStart(2, '0');
          name.textContent = country.name || countryName(country.code);
          count.textContent = numberFormatter.format(country.count);
          bar.style.setProperty('--visit-region-share', `${Math.max(8, (country.count / maxCount) * 100)}%`);
          item.append(rank, name, count, bar);
          fields.list.append(item);
        });
      }

      function renderMap(countries) {
        if (!map) return;

        loadMap().then(() => highlightMapCountries(countries || []));
      }

      async function loadMap() {
        if (!map || map.dataset.loaded === 'true') return;
        if (mapLoad) return mapLoad;

        mapLoad = window
          .fetch(map.dataset.mapSrc, { cache: 'force-cache' })
          .then((response) => {
            if (!response.ok) throw new Error(`Map failed: ${response.status}`);
            return response.text();
          })
          .then((svgText) => {
            const documentParser = new DOMParser();
            const svgDocument = documentParser.parseFromString(svgText, 'image/svg+xml');
            const svg = svgDocument.documentElement;

            svg.removeAttribute('style');
            svg.classList.add('plain-world-svg');
            svg.setAttribute('aria-hidden', 'true');
            svg.querySelectorAll('style').forEach((style) => style.remove());
            svg.querySelectorAll('g[id]').forEach((group) => {
              group.dataset.country = group.id;
            });

            map.replaceChildren(svg);
            map.dataset.loaded = 'true';
          })
          .catch(() => {
            map.textContent = 'map unavailable';
            map.dataset.loaded = 'false';
          });

        return mapLoad;
      }

      function highlightMapCountries(countries) {
        if (!map || map.dataset.loaded !== 'true') return;

        const rankedCountries = countries.filter((country) => country.code && country.count > 0);
        const maxCount = Math.max(1, ...rankedCountries.map((country) => country.count));
        map.querySelectorAll('g.is-active').forEach((group) => {
          group.classList.remove('is-active');
          group.style.removeProperty('--visit-country-fill');
        });

        rankedCountries.forEach((country) => {
          const group = map.querySelector(`#${window.CSS && CSS.escape ? CSS.escape(country.code) : country.code}`);
          if (!group) return;

          const alpha = 0.42 + Math.min(0.46, (country.count / maxCount) * 0.46);
          group.classList.add('is-active');
          group.style.setProperty('--visit-country-fill', `rgba(47, 111, 189, ${alpha.toFixed(2)})`);
        });
      }

      function normalizeStats(data, mode) {
        const countries = normalizeCountries(data.countries || data.countryCounts || data.points || data.regionsByCountry);

        return {
          mode: data.mode || mode,
          total: numberValue(data.total || data.totalViews || data.views),
          today: numberValue(data.today || data.todayViews),
          regions: numberValue(data.regions || data.regionCount || countries.length),
          lastUpdated: data.lastUpdated || data.updatedAt || new Date().toISOString(),
          countries,
          note: data.note,
        };
      }

      function normalizeCountries(input) {
        const rows = Array.isArray(input)
          ? input
          : Object.entries(input || {}).map(([code, value]) => ({
              code,
              count: typeof value === 'object' && value ? value.count : value,
              name: typeof value === 'object' && value ? value.name : '',
            }));

        return rows
          .map((row) => {
            const code = (row.code || row.country || '').toString().trim().toUpperCase();
            return {
              code,
              count: numberValue(row.count || row.views || row.value),
              name: row.name || countryName(code),
            };
          })
          .filter((row) => row.code && row.count > 0);
      }

      function relativeTime(value) {
        const timestamp = Date.parse(value);
        if (!timestamp) return 'just now';

        const seconds = Math.max(0, Math.round((Date.now() - timestamp) / 1000));
        if (seconds < 60) return 'just now';

        const minutes = Math.round(seconds / 60);
        if (minutes < 60) return `${minutes} min ago`;

        const hours = Math.round(minutes / 60);
        if (hours < 24) return `${hours} hr ago`;

        const days = Math.round(hours / 24);
        return `${days} day${days === 1 ? '' : 's'} ago`;
      }

      function numberValue(value) {
        const number = Number(value);
        return Number.isFinite(number) ? number : 0;
      }

      function countryName(code) {
        if (!code || code === 'XX') return 'Unknown';
        try {
          return regionNameFormatter ? regionNameFormatter.of(code) || code : code;
        } catch (error) {
          return code;
        }
      }

      function makeRegionNameFormatter() {
        try {
          if ('DisplayNames' in Intl) return new Intl.DisplayNames(['en'], { type: 'region' });
        } catch (error) {
          return null;
        }

        return null;
      }

      function cleanEndpoint(value) {
        return (value || '').toString().trim().replace(/\/$/, '');
      }

      function setText(element, value) {
        if (element) element.textContent = value;
      }
    }

    function initPlainCommandPalette() {
      if (document.querySelector('.plain-home')) return;

      const commands = [
        { cmd: 'cd ..', desc: 'Go back one page.', action: 'back' },
        { cmd: 'cd ~', desc: 'Return to the landing page.', href: "{{ '/' | relative_url }}" },
        { cmd: 'blog', desc: 'Open the writing index.', href: "{{ '/blog/' | relative_url }}" },
      ];
      const aliases = { writing: 'blog' };
      const blogUrl = "{{ '/blog/' | relative_url }}";

      const palette = document.createElement('div');
      palette.className = 'plain-command-palette';
      palette.hidden = true;
      palette.innerHTML = `
        <div class="plain-command-backdrop" data-command-close></div>
        <div class="plain-command-panel" role="dialog" aria-modal="true" aria-label="command">
          <label class="plain-command-line">
            <span class="sigil">$</span>
            <input id="plain-command-input" type="text" autocomplete="off" spellcheck="false" aria-label="command">
          </label>
        </div>
      `;
      document.body.append(palette);

      const commandInput = palette.querySelector('#plain-command-input');

      function isTypingTarget(element) {
        if (!element) return false;
        const tagName = element.tagName;
        return element.isContentEditable || tagName === 'INPUT' || tagName === 'TEXTAREA' || tagName === 'SELECT';
      }

      function openPalette(seed) {
        palette.hidden = false;
        document.body.classList.add('plain-command-open');
        commandInput.value = seed || '';
        commandInput.focus();
      }

      function closePalette() {
        palette.hidden = true;
        document.body.classList.remove('plain-command-open');
      }

      function parentPath() {
        const path = window.location.pathname.replace(/\/$/, '');
        const parent = path.split('/').slice(0, -1).join('/') || '/';
        return parent.endsWith('/') ? parent : `${parent}/`;
      }

      function hasSameOriginReferrer() {
        if (!document.referrer) return false;

        try {
          return new URL(document.referrer).origin === window.location.origin;
        } catch (error) {
          return false;
        }
      }

      function runPaletteCommand(command) {
        const raw = (command || '').trim().toLowerCase().replace(/^\//, '');
        const normalized = aliases[raw] || raw;
        const hit = commands.find((item) => item.cmd === normalized);
        const findMatch = normalized.match(/^find(?:\s+(.+))?$/);
        if (!hit && !findMatch) return;

        closePalette();

        if (findMatch) {
          const query = (findMatch[1] || '').trim();
          if (document.body.classList.contains('plain-writing-page')) {
            window.dispatchEvent(new CustomEvent('plain-writing-find', { detail: { query } }));
          } else {
            window.location.href = `${blogUrl}?find=${encodeURIComponent(query)}`;
          }
          return;
        }

        if (hit.action === 'back') {
          if (window.history.length > 1 && hasSameOriginReferrer()) {
            window.history.back();
          } else {
            window.location.href = parentPath();
          }
          return;
        }

        if (hit.href) window.location.href = hit.href;
      }

      document.addEventListener('keydown', (event) => {
        if (event.defaultPrevented || event.metaKey || event.ctrlKey || event.altKey) return;

        if (palette.hidden && event.key === '/' && !isTypingTarget(document.activeElement)) {
          event.preventDefault();
          openPalette();
          return;
        }

        if (palette.hidden) return;

        if (event.key === 'Escape') {
          event.preventDefault();
          closePalette();
        }

        if (event.key === 'Enter') {
          event.preventDefault();
          runPaletteCommand(commandInput.value);
        }
      });

      palette.addEventListener('click', (event) => {
        if (event.target.closest('[data-command-close]')) closePalette();
      });
    }

    const filters = document.getElementById('plain-writing-filters');
    if (filters) {
      const buttons = Array.from(filters.querySelectorAll('.plain-filter'));
      const sections = Array.from(document.querySelectorAll('[data-year-group]'));
      const empty = document.getElementById('plain-writing-empty');
      const filterState = {
        tag: 'all',
        title: new URLSearchParams(window.location.search).get('find') || '',
      };

      function applyFilter() {
        let anyVisible = false;
        const titleQuery = filterState.title.trim().toLowerCase();

        buttons.forEach((button) => {
          const isActive = button.dataset.tag === filterState.tag;
          button.classList.toggle('on', isActive);
          button.setAttribute('aria-pressed', isActive ? 'true' : 'false');
        });

        sections.forEach((section) => {
          let sectionVisible = false;

          section.querySelectorAll('.plain-entry').forEach((entry) => {
            const tags = (entry.dataset.tags || '').split(/\s+/).filter(Boolean);
            const titleNode = entry.querySelector('.title');
            const title = titleNode ? titleNode.textContent.trim().toLowerCase() : '';
            const tagMatch = filterState.tag === 'all' || tags.includes(filterState.tag);
            const titleMatch = !titleQuery || title.includes(titleQuery);
            const show = tagMatch && titleMatch;
            entry.hidden = !show;
            sectionVisible = sectionVisible || show;
          });

          section.hidden = !sectionVisible;
          anyVisible = anyVisible || sectionVisible;
        });

        if (empty) empty.hidden = anyVisible;
      }

      filters.addEventListener('click', (event) => {
        const button = event.target.closest('.plain-filter');
        if (!button) return;
        filterState.tag = button.dataset.tag;
        applyFilter();
      });

      window.addEventListener('plain-writing-find', (event) => {
        filterState.tag = 'all';
        filterState.title = event.detail && event.detail.query ? event.detail.query : '';
        applyFilter();
      });

      if (filterState.title) applyFilter();
    }

    const progress = document.getElementById('plain-progress');
    if (progress) {
      const updateProgress = () => {
        const root = document.documentElement;
        const scrollable = Math.max(1, root.scrollHeight - root.clientHeight);
        const pct = ((root.scrollTop || document.body.scrollTop) / scrollable) * 100;
        progress.style.width = `${Math.max(0, Math.min(100, pct))}%`;
      };

      document.addEventListener('scroll', updateProgress, { passive: true });
      updateProgress();
    }

    const toc = document.getElementById('plain-toc');
    const headings = Array.from(document.querySelectorAll('.plain-post-body h2'));
    if (toc && headings.length) {
      toc.innerHTML = '';

      headings.forEach((heading) => {
        if (!heading.id) {
          heading.id = heading.textContent
            .trim()
            .toLowerCase()
            .replace(/[^a-z0-9]+/g, '-')
            .replace(/^-|-$/g, '');
        }

        const item = document.createElement('li');
        const link = document.createElement('a');
        link.href = `#${heading.id}`;
        link.textContent = heading.textContent.replace(/^\d+\s*/, '');
        item.append(link);
        toc.append(item);
      });

      const map = Object.fromEntries(Array.from(toc.querySelectorAll('a')).map((link) => [link.hash.slice(1), link.parentElement]));

      const setActive = (id) => {
        toc.querySelectorAll('li').forEach((item) => item.classList.remove('active'));
        if (map[id]) map[id].classList.add('active');
      };

      setActive(headings[0].id);

      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) setActive(entry.target.id);
            });
          },
          { rootMargin: '0px 0px -70% 0px', threshold: 0 }
        );
        headings.forEach((heading) => observer.observe(heading));
      }
    }

    document.querySelectorAll('.plain-post-body .code-display-wrapper').forEach((wrapper) => {
      const button = wrapper.querySelector('.copy');
      if (button) button.setAttribute('title', 'Copy code');
    });
  });
</script>
